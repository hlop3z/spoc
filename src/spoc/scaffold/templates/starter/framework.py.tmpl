"""The entire framework definition for $project_name: one declaration.

These five kinds are SPOC's default vocabulary — the names reusable apps may
assume. Rename, remove, or add kinds freely; the registry treats any
vocabulary the same. Only `resources` uses lifecycle hooks: they open every
declared resource before a surface takes a call, and close them on the way
out.
"""

import spoc


def _open(resources_of_app):
    for resource in resources_of_app:
        resource.open()


def _close(resources_of_app):
    for resource in resources_of_app:
        resource.close()


framework = spoc.Framework(
    "models",
    spoc.KindSpec("views", depends_on=("models",)),
    "commands",
    spoc.KindSpec("resources", on_startup=_open, on_shutdown=_close),
    "hooks",
)

# One decorator per declared kind, named for one member of it: a kind is a
# category (plural), a decorator marks a single thing in it (singular), so
# `@view` reads correctly on the function it sits above.
model = framework.kind("models")
view = framework.kind("views")
command = framework.kind("commands")
resource = framework.kind("resources")
hook = framework.kind("hooks")
